rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && getUserData().role == 'admin';
    }

    function isOwner() {
      return userExists() && getUserData().role == 'owner';
    }

    function isTenant() {
      return userExists() && getUserData().role == 'tenant';
    }

    function isCaretaker() {
      return userExists() && getUserData().role == 'caretaker';
    }

    function getCaretakerData() {
      return get(/databases/$(database)/documents/caretakers/$(request.auth.uid)).data;
    }

    // Checks if the user is a caretaker with a specific permission flag set to true
    function caretakerHasPermission(permKey) {
      return isCaretaker() && (
        (getUserData().get('permissions', {}).get(permKey, false) == true) ||
        (exists(/databases/$(database)/documents/caretakers/$(request.auth.uid)) && 
         getCaretakerData().get('permissions', {}).get(permKey, false) == true)
      );
    }

    function isDocOwner(docData) {
      return docData.get('ownerUid', '') == request.auth.uid || 
             docData.get('ownerId', '') == request.auth.uid ||
             docData.get('createdBy', '') == request.auth.uid ||
             docData.get('userId', '') == request.auth.uid;
    }

    function isRecipient(docData) {
      return docData.get('userId', '') == request.auth.uid;
    }

    function isOwnedProperty(propertyId) {
      return propertyId != null && propertyId != '' &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerUid', '') == request.auth.uid;
    }

    // Rules functions can't use if-statements: one boolean expression per function
    // Pending (the normal sign-up), or approved only while auto-approve is on
    function isAllowedOwnerSignup(data) {
      return (
        data.get('approvalStatus', 'pending') == 'pending' &&
        data.get('status', 'pending') == 'pending'
      ) || (
        data.get('approvalStatus', '') == 'approved' &&
        data.get('status', '') == 'active' &&
        exists(/databases/$(database)/documents/settings/global) &&
        get(/databases/$(database)/documents/settings/global).data.get('autoApproveOwners', false) == true
      );
    }

    function isOwnedRecipient(userId) {
      return userId != null && userId != '' &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        isOwnedRecipientData(get(/databases/$(database)/documents/users/$(userId)).data);
    }

    // A tenant or caretaker who belongs to the signed-in owner
    function isOwnedRecipientData(recipient) {
      return (recipient.get('role', '') == 'tenant' || recipient.get('role', '') == 'caretaker') && (
        recipient.get('ownerUid', '') == request.auth.uid ||
        recipient.get('invitedBy', '') == request.auth.uid ||
        isOwnedProperty(recipient.get('propertyId', '')) ||
        isOwnedProperty(recipient.get('assignedPropertyId', ''))
      );
    }

    // ===============================================================
    // USERS COLLECTION
    // ===============================================================
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isAdmin() || 
        (
          request.auth.uid == userId &&
          request.resource.data.role != 'admin' &&
          // A new owner signs up waiting for review; they may only start approved
          // when an admin has turned on auto-approve (Admin → Settings)
          (request.resource.data.role != 'owner' || isAllowedOwnerSignup(request.resource.data))
        ) ||
        (
          isOwner() && 
          isDocOwner(request.resource.data)
        )
      );

      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'suspendedAt']) &&
        // An owner may only send themselves back for review (re-submitting documents), never approve
        // themselves, and a suspended account can't use this to get out of the suspension
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus']) ||
          (
            request.resource.data.approvalStatus == 'pending' &&
            (resource.data.get('status', '') != 'suspended' || resource.data.get('approvalStatus', '') == 'rejected')
          )
        ) &&
        // status: only a declined owner re-submitting, back to 'pending' (never after an admin suspension)
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          (
            resource.data.get('approvalStatus', '') == 'rejected' &&
            resource.data.get('suspendedAt', null) == null &&
            request.resource.data.status == 'pending'
          )
        )
      ) || (
        isOwner() && 
        isDocOwner(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvalStatus', 'ownerUid'])
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // GLOBAL SETTINGS & ANNOUNCEMENTS
    // ===============================================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /owner_announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        isCaretaker() || 
        isTenant() || 
        isDocOwner(resource.data)
      );
      allow create: if isOwner() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update, delete: if isAdmin() || (
        isOwner() && 
        (resource.data.get('ownerId', '') == request.auth.uid || isDocOwner(resource.data))
      );
    }

    // ===============================================================
    // NOTIFICATIONS
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || isRecipient(resource.data));
      
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.get('createdBy', '') == request.auth.uid ||
        isRecipient(request.resource.data) || 
        (
          isOwner() &&
          request.resource.data.get('ownerId', '') == request.auth.uid &&
          isOwnedRecipient(request.resource.data.get('userId', ''))
        ) ||
        isDocOwner(request.resource.data)
      );

      allow update: if isAdmin() || (
        isSignedIn() && 
        isRecipient(resource.data) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );

      allow delete: if isAdmin() || (isSignedIn() && isRecipient(resource.data));
    }

    // ===============================================================
    // PROPERTIES, TENANTS, CARETAKERS, PAYMENTS
    // ===============================================================
    
    match /properties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner() && isDocOwner(request.resource.data));
      allow update: if isAdmin() || (
        isOwner() && isDocOwner(resource.data)
      ) || (
        caretakerHasPermission('modifyLayout') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rooms', 'totalRooms', 'totalBeds', 'totalFloors', 'updatedAt'])
      );
      // ✅ Enforce Soft Deletion: Hard delete disabled to protect dependent occupancy and lease history
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (
        tenantId == request.auth.uid || 
        isAdmin() || 
        isOwner() || 
        isCaretaker() || 
        resource.data.get('tenantId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAdmin() || (isOwner() && isDocOwner(request.resource.data));
      allow update: if isAdmin() || (isOwner() && isDocOwner(resource.data));
      // ✅ Enforce Soft Deletion: Use status = 'Inactive' instead of hard deleting to preserve financial audit trail
      allow delete: if false;
    }

    match /caretakers/{caretakerId} {
      allow read: if isSignedIn() && (
        caretakerId == request.auth.uid || 
        isAdmin() || 
        isOwner() || 
        resource.data.get('caretakerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAdmin() || (isOwner() && isDocOwner(request.resource.data));
      allow update: if isAdmin() || (isOwner() && isDocOwner(resource.data)) || (
        // A caretaker marks their own record once they've replaced the temporary password
        caretakerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']) &&
        request.resource.data.mustChangePassword == false
      );
      // ✅ Enforce Soft Deletion: Use status = 'Inactive' instead of hard deleting
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        isCaretaker() || 
        isDocOwner(resource.data) || 
        resource.data.get('tenantId', '') == request.auth.uid 
      );
      allow create: if isAdmin() || (isOwner() && isDocOwner(request.resource.data)) || (
        caretakerHasPermission('viewFinancials') && 
        request.resource.data.get('paymentMethod', '') == 'Cash'
      ) || (
        // A tenant submits their own payment for the owner to verify. It always starts
        // as Pending and can't carry a receipt number or a verification.
        isTenant() &&
        request.resource.data.get('tenantId', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'Pending' &&
        request.resource.data.get('verificationStatus', '') == 'Pending' &&
        !request.resource.data.keys().hasAny(['receiptNo', 'receiptSeq', 'receiptIssuer', 'receiptIssuedAt', 'verifiedAt', 'verifiedBy'])
      );
      allow update: if isAdmin() || (isOwner() && isDocOwner(resource.data));
      // ✅ Financial records must never be hard deleted
      allow delete: if false;
    }

    // ===============================================================
    // OCCUPANCY & CURFEW LOGS / RECORDS
    // ===============================================================
    
    // Private record per tenant per night
    match /curfew_records/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('tenantId', '') == request.auth.uid ||
        resource.data.get('ownerUid', '') == request.auth.uid ||
        caretakerHasPermission('logOccupancy')
      );
      allow create, update, delete: if isSignedIn() && (
        isAdmin() || 
        caretakerHasPermission('logOccupancy')
      );
    }

    // Night's full sheet (tenants strictly prohibited)
    match /occupancy_logs/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        caretakerHasPermission('logOccupancy')
      );
      allow write: if isSignedIn() && (
        isAdmin() || 
        caretakerHasPermission('logOccupancy')
      );
    }

    // ===============================================================
    // MAINTENANCE TICKETS (Handles 'maintenance' & 'maintenance_tickets')
    // ===============================================================
    
    match /maintenance/{ticketId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        isCaretaker() || 
        isTenant() || 
        resource.data.get('ownerUid', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        resource.data.get('tenantId', '') == request.auth.uid ||
        resource.data.get('tenantUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      
      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        caretakerHasPermission('handleReports') ||
        (
          resource.data.get('tenantUid', '') == request.auth.uid &&
          (
            (
              resource.data.get('status', 'Pending') == 'Pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'followUps', 'updatedAt'])
            ) ||
            (
              resource.data.get('status', 'Pending') != 'Pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followUps', 'updatedAt'])
            )
          )
        )
      );

      allow delete: if isSignedIn() && (
        isAdmin() || 
        isOwner() ||
        (
          resource.data.get('tenantUid', '') == request.auth.uid &&
          resource.data.get('status', 'Pending') == 'Pending'
        )
      );
    }

    match /maintenance_tickets/{ticketId} {
      allow read: if isSignedIn() && (
        isAdmin() || isOwner() || isCaretaker() || isTenant() || 
        resource.data.get('ownerUid', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        resource.data.get('tenantId', '') == request.auth.uid ||
        resource.data.get('tenantUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      
      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() || 
        isOwner() || 
        caretakerHasPermission('handleReports') ||
        (
          resource.data.get('tenantUid', '') == request.auth.uid &&
          (
            (
              resource.data.get('status', 'Pending') == 'Pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'followUps', 'updatedAt'])
            ) ||
            (
              resource.data.get('status', 'Pending') != 'Pending' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followUps', 'updatedAt'])
            )
          )
        )
      );

      allow delete: if isSignedIn() && (
        isAdmin() || 
        isOwner() ||
        (
          resource.data.get('tenantUid', '') == request.auth.uid &&
          resource.data.get('status', 'Pending') == 'Pending'
        )
      );
    }
  }
}